# The default configuration runs without paid APIs or downloaded model weights.
PPT_PROVIDER=local
LLM_PROVIDER=mock
VOICE_PROVIDER=mock
AVATAR_PROVIDER=mock
IMAGE_BACKGROUND_PROVIDER=mock
VIDEO_BACKGROUND_PROVIDER=mock

# Set these only after deploying a private NVIDIA GPU Worker.
GPU_WORKER_BASE_URL=
GPU_WORKER_TOKEN=

# Fire Volcano Engine OmniHuman 1.5 uses the Visual API instead of a GPU Worker.
# VOLCENGINE_PUBLIC_UPLOAD_BASE_URL must expose this app's /uploads files over the public network.
# Example: https://your-domain.example/uploads
# Never commit the real access keys.
VOLCENGINE_ACCESS_KEY_ID=
VOLCENGINE_SECRET_ACCESS_KEY=
VOLCENGINE_PUBLIC_UPLOAD_BASE_URL=

# An explicit OpenAI-compatible endpoint for script generation. It may point to a
# local model server or a cloud API, but it is never used while LLM_PROVIDER=mock.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Optional external services. Leave blank unless the corresponding provider is enabled.
OPENAI_BASE_URL=
OPENAI_API_KEY=
VOICE_CLONE_API_URL=
VOICE_CLONE_API_KEY=
