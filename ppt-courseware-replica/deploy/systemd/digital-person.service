[Unit]
Description=Digital Person API
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/digital-person/ppt-courseware-replica
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm run server
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=digital-person

[Install]
WantedBy=multi-user.target
